#!/usr/bin/env bash

if ! declare -F admission_priority_names >/dev/null; then
	# shellcheck disable=SC1091
	source "${BASH_SOURCE[0]%/*}/admission_priority.bash"
fi

build_budget_valid_project() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; }

# Pure argument construction, also exercised without a live user manager.
build_budget_args() {
	local -n result="$1"
	local project="$2" identity="$3" cwd="$4"
	shift 4
	result=(--user --scope --quiet --slice=agentbuilds.slice
		"--unit=build-$project-$identity.scope" "--working-directory=$cwd"
		--property=MemoryHigh=16G --property=MemoryMax=16G
		--property=MemorySwapMax=0 --property=OOMPolicy=stop
		"--property=RuntimeMaxSec=${BUILD_BUDGET_RUNTIME_SECONDS:-1800}" --property=TimeoutStopSec=5s -- "$@")
}

# Linux process birth ticks distinguish a live owner from a reused PID.
build_budget_process_identity() {
	local stat rest
	{ IFS= read -r stat < "/proc/$1/stat"; } 2>/dev/null || return 1
	rest=${stat##*) }
	local -a fields=()
	read -r -a fields <<< "$rest"
	[[ "${fields[0]-}" != Z ]] || return 3
	[[ "${fields[19]-}" =~ ^[0-9]+$ ]] || return 2
	printf '%s\n' "${fields[19]}"
}

# Nameref output transfers the caller's ticket path.
# shellcheck disable=SC2034
build_budget_register_ticket() {
	local -n ticket_out="$1"
	local runtime="$2" project="${3:-unknown}" gate sequence=0 birth path temporary owner=$BASHPID
	build_budget_valid_project "$project" || return 2
	mkdir -p "$runtime/waiters" || return 1
	exec {gate}> "$runtime/.queue.lock" || return 1
	if ! flock "$gate"; then exec {gate}>&-; return 1; fi
	if [[ -e "$runtime/sequence" ]]; then
		read -r sequence < "$runtime/sequence" || { exec {gate}>&-; return 1; }
	fi
	[[ "$sequence" =~ ^[0-9]{1,12}$ ]] || { exec {gate}>&-; return 1; }
	sequence=$((sequence+1))
	birth=$(build_budget_process_identity "$owner") || { exec {gate}>&-; return 1; }
	printf -v path '%s/waiters/%020d' "$runtime" "$sequence"
	temporary=$(command mktemp "$runtime/.ticket.XXXXXXXX") || { exec {gate}>&-; return 1; }
	if ! printf '%s\n' "$sequence" > "$temporary" || ! command mv -f -- "$temporary" "$runtime/sequence"; then exec {gate}>&-; return 1; fi
	temporary=$(command mktemp "$runtime/.ticket.XXXXXXXX") || { exec {gate}>&-; return 1; }
	if ! printf '%s %s %s\n' "$owner" "$birth" "$project" > "$temporary" || ! command mv -f -- "$temporary" "$path"; then exec {gate}>&-; return 1; fi
	ticket_out=$path
	exec {gate}>&-
}

build_budget_ticket_first() {
	local ticket="$1" runtime="$2" held="${3:-false}" gate='' path pid birth project observed first='' status=1 owner_status names rank best_rank=2 wanted listing
	if [[ "$held" != true ]]; then
		exec {gate}> "$runtime/.queue.lock" || return 2
		if ! flock "$gate"; then exec {gate}>&-; return 2; fi
	fi
	names=$(build_budget_priority_names) || { [[ -z "$gate" ]] || exec {gate}>&-; return 2; }
	local -a priorities=()
	mapfile -t priorities < <(jq -r '.[]' <<< "$names")
	# Nix runtime Bash lacks readline's compgen builtin. Use a pinned directory
	# adapter and check its status before parsing, including under noglob.
	local -a tickets=()
	if ! listing=$(command find "$runtime/waiters" -mindepth 1 -maxdepth 1 -type f -name '[0-9]*' -print); then [[ -z "$gate" ]] || exec {gate}>&-; return 2; fi
	listing=$(printf '%s\n' "$listing" | LC_ALL=C sort) || { [[ -z "$gate" ]] || exec {gate}>&-; return 2; }
	mapfile -t tickets <<< "$listing"
	for path in "${tickets[@]}"; do
		[[ -f "$path" ]] || continue
		if ! read -r pid birth project < "$path" || [[ ! "$pid" =~ ^[0-9]+$ ]]; then status=2; break; fi
		if observed=$(build_budget_process_identity "$pid"); then
			if [[ "$observed" = "$birth" ]]; then
				rank=1
				for wanted in "${priorities[@]}"; do if [[ "$wanted" = "$project" ]]; then rank=0; break; fi; done
				if (( rank < best_rank )); then first=$path; best_rank=$rank; fi
				continue
			fi
		else
			owner_status=$?
			if [[ "$owner_status" -ne 3 && -e "/proc/$pid" ]]; then status=2; break; fi
		fi
		command unlink "$path" || { status=2; break; }
	done
	if [[ "$status" -ne 2 && "$first" = "$ticket" ]]; then status=0; fi
	[[ -z "$gate" ]] || exec {gate}>&-
	return "$status"
}

build_budget_priority_names() {
	admission_priority_names /etc/mechatron-prime/scheduling.json "$(admission_priority_now)"
}

# Production polling is bounded; tests replace this wait port with barriers.
build_budget_wait() { sleep 1; }

build_budget_acquire_fair_slot() {
	local output="$1" runtime="$2" ticket="$3" status warned=0 gate
	while :; do
		exec {gate}> "$runtime/.queue.lock" || return 1
		if ! flock "$gate"; then exec {gate}>&-; return 1; fi
		if build_budget_ticket_first "$ticket" "$runtime" true; then
			if build_budget_acquire_slot "$output" "$runtime"; then
				exec {gate}>&-; return 0
			else status=$?; fi
			[[ "$status" -eq 75 ]] && status=1
		else status=$?; fi
		exec {gate}>&-
		[[ "$status" -eq 1 ]] || return "$status"
		if [[ "$warned" -eq 0 ]]; then printf 'build-budget: waiting behind older queued work\n' >&2; warned=1; fi
		build_budget_wait || return $?
	done
}

build_budget_runtime_limit() {
	local project="$1" policy="${2:-/etc/mechatron-prime/runtime-approvals.json}"
	if [[ ! -e "$policy" ]]; then printf '1800\n'; return 0; fi
	jq -er --arg key "local/$project" '
		if .schema != "mechatron-runtime-approvals/v1" or (.approvals|type) != "object" then error("invalid registry")
		elif .approvals[$key] == null then 1800
		else .approvals[$key] | if .approved_by == "mechatron-prime" and (.reason|type)=="string" and (.reason|length)>0
			and (.seconds|type)=="number" and .seconds==(.seconds|floor) and .seconds>0 and .seconds<=86400
			then .seconds else error("invalid runtime approval") end end' "$policy" 2>/dev/null
}

# Try both slots under the admission gate. Return 75 when full; the caller
# releases the gate and rechecks priority/age before its next attempt.
# shellcheck disable=SC2034
build_budget_acquire_slot() {
	local -n selected_fd="$1"
	local runtime="$2" fd status slot
	for slot in 1 2; do
		exec {fd}>"$runtime/slot-$slot.lock" || return 1
		if flock -n -E 75 "$fd"; then selected_fd=$fd; return 0; else status=$?; fi
		exec {fd}>&-
		[[ "$status" -eq 75 ]] || return "$status"
	done
	return 75
}

build_budget_main() (
	set +e
	set -u
	local project='' runtime state identity unit slot_fd scratch='' rc base ticket=''
	local rm_bin="${BUILD_BUDGET_RM:-/run/current-system/sw/bin/rm}"
	local -a args=()
	case "${1-}" in
		-h|--help)
			printf 'Usage: build-budget [--project NAME] -- COMMAND [ARG...]\nTwo FIFO build/test slots; 30-minute execution default, 16 GiB memory limit that fails fast and no swap.\nLonger runs require infrastructure approval. Queue wait is excluded.\nRuns outside the agent cgroup. Successful task-owned scratch is removed; failed scratch is retained.\nBypassed or pre-existing jobs are not covered. Nix daemon builders retain their separate budget.\n'; exit 0 ;;
		--about) printf 'build-budget 1.0: Linux systemd build-memory containment\n'; exit 0 ;;
		--project) project="${2-}"; [[ $# -ge 2 ]] || exit 2; shift 2 ;;
	esac
	[[ -n "$project" ]] || project="${PWD##*/}"
	if ! build_budget_valid_project "$project" || [[ "${1-}" != -- || $# -lt 2 ]]; then
		printf 'build-budget: valid project and -- COMMAND required\n' >&2; exit 2
	fi
	shift
	if [[ "$rm_bin" != /* || ! -x "$rm_bin" ]]; then
		printf 'build-budget: cleanup requires an absolute executable GNU rm adapter\n' >&2; exit 1
	fi
	local envelope
	envelope=$(systemctl --user show agentbuilds.slice -p MemoryMax --value 2>/dev/null)
	if [[ "$envelope" != 34359738368 ]]; then
		printf 'build-budget: required 32 GiB aggregate slice is not installed; refusing an unbounded run\n' >&2; exit 1
	fi
	runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/build-budget"
	state="${XDG_STATE_HOME:-$HOME/.local/state}/build-budget"
	umask 077
	if ! mkdir -p -- "$runtime" "$state"; then exit 1; fi
	if [[ ! -O "$runtime" || -L "$runtime" || ! -O "$state" || -L "$state" ]]; then
		printf 'build-budget: state/runtime must be owned real directories\n' >&2; exit 1
	fi
	chmod 700 -- "$runtime" "$state" || exit 1
	trap 'exit 130' INT
	trap 'exit 143' TERM
	local BUILD_BUDGET_RUNTIME_SECONDS
	BUILD_BUDGET_RUNTIME_SECONDS=$(build_budget_runtime_limit "$project") || { printf 'build-budget: invalid runtime approval registry\n' >&2; exit 1; }
	build_budget_register_ticket ticket "$runtime" "$project" || exit $?
	trap '[[ -z "$ticket" || ! -e "$ticket" ]] || command unlink "$ticket"' EXIT
	build_budget_acquire_fair_slot slot_fd "$runtime" "$ticket" || exit $?
	command unlink "$ticket" || exit 1
	ticket=''
	identity=$(cat /proc/sys/kernel/random/uuid) || exit 1
	unit="build-$project-$identity.scope"
	base="${TMPDIR:-/tmp}"
	scratch=$(mktemp -d "$base/build-$project.XXXXXXXX") || exit 1
	# shellcheck disable=SC2329 # invoked by the EXIT trap
	build_budget_finish() {
		local status="$1" properties peak result record
		properties=$(systemctl --user show "$unit" -p MemoryPeak -p Result --value 2>/dev/null)
		peak=$(awk '/^[0-9]+$/ {print; exit}' <<< "$properties")
		result=$(awk '!/^[0-9]+$/ && NF {print; exit}' <<< "$properties")
		record=$(jq -nc --arg project "$project" --arg unit "$unit" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			--arg scratch "$scratch" --arg peak "$peak" --arg result "$result" --argjson status "$status" \
			'{schema:"build-budget/v1",project:$project,unit:$unit,datetime:$now,exit_code:$status,result:$result,peak_bytes:(try ($peak|tonumber) catch null),scratch:$scratch}')
		# Serialize one complete JSON record; failed receipts must remain visible.
		if ! (flock 9 && printf '%s\n' "$record" >&9) 9>>"$state/runs.ndjson"; then
			printf 'build-budget: could not persist completion receipt\n' >&2
		fi
		if [[ "$status" -eq 0 && -d "$scratch" && ! -L "$scratch" && "$scratch" == "$base/build-$project."* ]]; then
			if systemctl --user is-active --quiet "$unit"; then
				printf 'build-budget: job still has live processes; scratch retained at %s\n' "$scratch" >&2
			else
				"$rm_bin" -r --one-file-system --preserve-root=all -- "$scratch" || printf 'build-budget: scratch cleanup failed: %s\n' "$scratch" >&2
			fi
		else
			printf 'build-budget: exit=%s; scratch retained at %s\n' "$status" "$scratch" >&2
		fi
	}
	trap 'build_budget_finish "$?"' EXIT
	build_budget_args args "$project" "$identity" "$PWD" env "TMPDIR=$scratch" "$@"
	printf 'build-budget: %s, maximum 16 GiB\n' "$unit" >&2
	# Only the wrapper owns the lease; descendants must not retain its FD.
	systemd-run "${args[@]}" {slot_fd}>&-
	rc=$?
	exit "$rc"
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then build_budget_main "$@"; fi
