#!/usr/bin/env bash
# Tailnet client for Mechatron Prime status and exact operational controls.
set -u

version="0.1.0"
default_url="https://thelio-nixos.tail66c90.ts.net:8444/ops"
supported_locales="am ar az bg bn bs da de el en es fa fi fil fr ha he hi hr hu id ig is it ja km ko mk nb nl pa pl ps pt_br ro ru sl sq sr sv sw ta th tr uk ur vi yo zh_hans zh_hant"

message() {
	case "$1" in
		title) printf 'Mechatron Prime CI' ;;
		worker) printf 'Worker' ;;
		queue) printf 'Queue' ;;
		current) printf 'Current' ;;
		recent) printf 'Recent outcomes' ;;
		history) printf 'Mechatron Prime CI history' ;;
		none) printf 'none' ;;
		unknown_command) printf 'unknown command' ;;
		unsupported_locale) printf 'unsupported locale' ;;
		invalid_response) printf 'server returned an invalid CI status document' ;;
		invalid_history) printf 'server returned an invalid CI history document' ;;
		invalid_limit) printf 'history limit must be an integer from 1 through 100' ;;
		help) printf '%s\n' \
			'Usage: mechatron-ci [options] [status|log|halt|resume|cancel]' \
			'' \
			'Commands:' \
			'  status       Show admission, worker, queue, current job, and recent results' \
			'  log          Show a bounded, sanitized history of CI results' \
			'  halt         Persistently halt admission and cancel/requeue active work' \
			'  resume       Reopen admission and immediately drain queued work' \
			'  cancel       Cancel/requeue only the active build; admission stays unchanged' \
			'' \
			'Options:' \
			'  --json       Emit the stable JSON status document' \
			'  --limit N    Return 1–100 history results (default: 50; log only)' \
			'  --url URL    Override the tailnet operations base URL' \
			'  --lang CODE  Select one of the prepared locale codes' \
			'  --simple     Suppress decorated terminal output' \
			'  --no-color   Suppress ANSI color' \
			'  --no-ansi    Suppress all ANSI styling' \
			'  -h, --help   Show this help' \
			'  --about      Show version, platform, and architecture' ;;
		*) return 1 ;;
	esac
}

locale_supported() {
	local wanted="$1"
	local locale
	for locale in $supported_locales; do
		[ "$wanted" = "$locale" ] && return 0
	done
	return 1
}

normalize_locale() {
	local value="${1:-en}"
	value="${value%%.*}"
	value="${value%%@*}"
	value="${value//-/_}"
	value="${value,,}"
	case "$value" in
		c|posix|'') printf 'en\n'; return ;;
		zh_hant*) printf 'zh_hant\n'; return ;;
		zh_hans*) printf 'zh_hans\n'; return ;;
		zh_tw*|zh_hk*|zh_mo*) printf 'zh_hant\n'; return ;;
		zh*) printf 'zh_hans\n'; return ;;
	esac
	local locale
	for locale in pt_br fil am ar az bg bn bs da de el en es fa "fi" fr ha he hi hr hu id ig is it ja km ko mk nb nl pa pl ps ro ru sl sq sr sv sw ta th tr uk ur vi yo; do
		case "$value" in "$locale"|"$locale"_*) printf '%s\n' "$locale"; return ;; esac
	done
	printf '%s\n' "$value"
}

command=status
emit_json=false
base_url="${MECHATRON_CI_URL:-$default_url}"
explicit_lang=""
show_help=false
show_about=false
history_limit=50
history_limit_set=false

while [ "$#" -gt 0 ]; do
	case "$1" in
		status|log|halt|resume|cancel) command="$1" ;;
		--json) emit_json=true ;;
		--simple|--no-color|--no-ansi) ;;
		--limit)
			[ "$#" -ge 2 ] || { printf '%s: --limit requires a value\n' "$(message title)" >&2; exit 2; }
			shift
			history_limit="$1"
			history_limit_set=true
			;;
		--url)
			[ "$#" -ge 2 ] || { printf '%s: --url requires a value\n' "$(message title)" >&2; exit 2; }
			shift
			base_url="$1"
			;;
		--lang)
			[ "$#" -ge 2 ] || { printf '%s: --lang requires a value\n' "$(message title)" >&2; exit 2; }
			shift
			explicit_lang="$1"
			;;
		-h|--help) show_help=true ;;
		--about) show_about=true ;;
		--)
			shift
			[ "$#" -eq 0 ] || { printf '%s: %s: %s\n' "$(message title)" "$(message unknown_command)" "$1" >&2; exit 2; }
			break
			;;
		*) printf '%s: %s: %s\n' "$(message title)" "$(message unknown_command)" "$1" >&2; exit 2 ;;
	esac
	shift
done

if [ "$show_about" = true ]; then
	printf 'mechatron-ci %s — Mechatron Prime tailnet CI control — %s %s\n' "$version" "$(uname -s)" "$(uname -m)"
	exit 0
fi

if [ "$show_help" = true ]; then
	message help
	exit 0
fi

locale_request="$explicit_lang"
if [ -z "$locale_request" ]; then locale_request="${MECHATRON_CI_LANG:-}"; fi
if [ -z "$locale_request" ]; then
	native_locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
	if [ -n "${LANGUAGE:-}" ] && [ "$native_locale" != C ] && [ "$native_locale" != POSIX ]; then
		locale_request="${LANGUAGE%%:*}"
	else
		locale_request="$native_locale"
	fi
fi
locale="$(normalize_locale "$locale_request")"
if ! locale_supported "$locale"; then
	printf '%s: %s: %s\n' "$(message title)" "$(message unsupported_locale)" "$locale_request" >&2
	exit 2
fi
if [ "$locale" != en ]; then
	printf 'WARN: i18n missing-locale %s\n' "$locale" >&2
fi

if [ "$history_limit_set" = true ] && [ "$command" != log ]; then
	printf '%s: %s\n' "$(message title)" "$(message invalid_limit)" >&2
	exit 2
fi
case "$history_limit" in
	''|*[!0-9]*) printf '%s: %s\n' "$(message title)" "$(message invalid_limit)" >&2; exit 2 ;;
esac
if [ "$history_limit" -lt 1 ] || [ "$history_limit" -gt 100 ]; then
	printf '%s: %s\n' "$(message title)" "$(message invalid_limit)" >&2
	exit 2
fi

base_url="${base_url%/}"
curl_command="${MECHATRON_CI_CURL:-curl}"

fetch_status() {
	"$curl_command" --fail --silent --show-error --connect-timeout 5 --max-time 15 "$base_url/ci.json"
}

fetch_history() {
	"$curl_command" --fail --silent --show-error --connect-timeout 5 --max-time 15 "$base_url/ci-log.json"
}

post_action() {
	local route="$1"
	"$curl_command" --fail --silent --show-error --connect-timeout 5 --max-time 30 \
		--request POST --output /dev/null "$base_url/actions/mechatron-worker/$route"
}

case "$command" in
	halt) post_action halt || exit $? ;;
	resume) post_action resume || exit $? ;;
	cancel) post_action stop || exit $? ;;
esac

if [ "$command" = log ]; then
	document="$(fetch_history)" || exit $?
	if ! jq -e '
		type == "object" and
		(.generated_at | type == "string") and
		(.results | type == "array") and
		(all(.results[];
			(.repository | type == "string") and
			(.commit_sha | type == "string") and
			(.status == "success" or .status == "failure") and
			(.failure_stage | type == "string") and
			(.failure_detail | type == "string") and
			(.started_at | type == "string") and
			(.finished_at | type == "string")
		))
	' <<< "$document" >/dev/null 2>&1; then
		printf '%s: %s\n' "$(message title)" "$(message invalid_history)" >&2
		exit 1
	fi
	document="$(jq --argjson limit "$history_limit" '.results = .results[0:$limit]' <<< "$document")" || exit $?
	if [ "$emit_json" = true ]; then
		jq . <<< "$document"
		exit $?
	fi
	jq -r --arg title "$(message history)" '
		[$title + " (" + (.results | length | tostring) + " newest)"] +
		[.results[] |
			"  " + (.finished_at // .started_at) +
			"  " + (if .status == "success" then "PASS" else "FAIL" end) +
			"  " + .repository + "@" + (.commit_sha[0:12]) +
			(if .status == "failure" then
				(if .failure_stage == "" then "" else "  " + .failure_stage end) +
				(if .failure_detail == "" then "" else (if .failure_stage == "" then "  " else ": " end) + .failure_detail end)
			else "" end)
		] | .[]
	' <<< "$document"
	exit $?
fi

document="$(fetch_status)" || exit $?
if ! jq -e '
	type == "object" and
	(.generated_at | type == "string") and
	(.admission.state == "running" or .admission.state == "halted") and
	(.worker.state | type == "string") and
	(.worker.queue_depth | type == "number") and
	(.recent | type == "array")
' <<< "$document" >/dev/null 2>&1; then
	printf '%s: %s\n' "$(message title)" "$(message invalid_response)" >&2
	exit 1
fi

if [ "$emit_json" = true ]; then
	jq . <<< "$document"
	exit $?
fi

jq -r \
	--arg title "$(message title)" \
	--arg worker_label "$(message worker)" \
	--arg queue_label "$(message queue)" \
	--arg current_label "$(message current)" \
	--arg recent_label "$(message recent)" \
	--arg none "$(message none)" '
	(.admission.state | ascii_upcase) as $admission |
	(.worker.state // "unknown") as $worker |
	(if .worker.current then (.worker.current.repository + "@" + (.worker.current.commit_sha[0:12]) + " " + .worker.current.target) else $none end) as $current |
	[$title + ": " + $admission,
	 $worker_label + ": " + $worker + "  " + $queue_label + ": " + (.worker.queue_depth | tostring),
	 $current_label + ": " + $current,
	 $recent_label + ":"] +
	(if (.recent | length) == 0 then ["  " + $none] else [.recent[] | "  " + (if .status == "success" then "PASS" else "FAIL" end) + "  " + .repository + "@" + (.commit_sha[0:12]) + (if .failure_stage == "" then "" else "  " + .failure_stage end)] end) |
	.[]
' <<< "$document"
