#!/usr/bin/env bash
# Exact control surface for persistent CI admission and active-worker state.
set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! declare -F write_ci_admission >/dev/null; then
	# shellcheck disable=SC1090
	source "${MECHATRON_CONTROL_LIB:-$script_dir/control_lib.bash}"
fi
if ! declare -F select_queue_records >/dev/null; then
	# shellcheck disable=SC1090
	source "${MECHATRON_POLICY_LIB:-$script_dir/policy.bash}"
fi
if ! declare -F record_ci_result >/dev/null; then
	# shellcheck disable=SC1090
	source "${MECHATRON_STATUS_STORE_LIB:-$script_dir/status_store.bash}"
fi

state_dir="${MECHATRON_STATE_DIR:-/var/lib/mechatron-prime}"
badge_dir="${MECHATRON_BADGE_DIR:-/var/lib/mechatron-prime-public/badges}"
systemctl_command="${MECHATRON_SYSTEMCTL:-systemctl}"
now="${MECHATRON_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
action="${1:-}"

case "$action" in
	halt)
		write_ci_admission "$state_dir" halted "$now" || exit 1
		"$systemctl_command" --no-block stop mechatron-prime-worker.service mechatron-prime-worker@1.service mechatron-prime-worker@2.service || exit 1
		;;
	resume)
		write_ci_admission "$state_dir" running "$now" || exit 1
		"$systemctl_command" --no-block start mechatron-prime-worker.service || exit 1
		;;
	cancel)
		"$systemctl_command" --no-block stop mechatron-prime-worker.service mechatron-prime-worker@1.service mechatron-prime-worker@2.service || exit 1
		;;
	drop)
		shift
		drop_project=""
		drop_branch=""
		drop_commit=""
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--project) [ "$#" -ge 2 ] || { printf 'drop: --project requires a value\n' >&2; exit 2; }; shift; drop_project="$1" ;;
				--branch) [ "$#" -ge 2 ] || { printf 'drop: --branch requires a value\n' >&2; exit 2; }; shift; drop_branch="$1" ;;
				--commit) [ "$#" -ge 2 ] || { printf 'drop: --commit requires a value\n' >&2; exit 2; }; shift; drop_commit="$1" ;;
				*) printf 'drop: unknown option: %s\n' "$1" >&2; exit 2 ;;
			esac
			shift
		done
		# A project is mandatory. Without it a typo or an empty variable would
		# widen into "cancel every queued build on the host".
		[ -n "$drop_project" ] || { printf 'drop: --project is required\n' >&2; exit 2; }

		drop_queue="$state_dir/queue/builds.ndjson"
		drop_lock="$state_dir/queue/.builds.lock"
		[ -f "$drop_queue" ] || { jq -cn --arg action drop '{status:"ok",action:$action,dropped:0}'; exit 0; }

		# Take the receiver's own lock. If the worker has already claimed the
		# batch these records are no longer here, so the drop is correctly a
		# no-op rather than a second verdict for a build that is about to run.
		exec 8> "$drop_lock" || exit 1
		flock 8 || exit 1

		drop_matched="$(mktemp "${drop_queue}.drop.XXXXXX")" || exit 1
		drop_kept="$(mktemp "${drop_queue}.keep.XXXXXX")" || exit 1
		select_queue_records match "$drop_project" "$drop_branch" "$drop_commit" < "$drop_queue" > "$drop_matched" || { rm -f -- "$drop_matched" "$drop_kept"; exit 1; }
		select_queue_records exclude "$drop_project" "$drop_branch" "$drop_commit" < "$drop_queue" > "$drop_kept" || { rm -f -- "$drop_matched" "$drop_kept"; exit 1; }

		drop_count="$(wc -l < "$drop_matched" | tr -d ' ')"
		if [ "$drop_count" -eq 0 ]; then
			rm -f -- "$drop_matched" "$drop_kept"
			exec 8>&-
			jq -cn --arg action drop '{status:"ok",action:$action,dropped:0}'
			exit 0
		fi

		chmod 0640 "$drop_kept" || { rm -f -- "$drop_matched" "$drop_kept"; exit 1; }
		mv -f -- "$drop_kept" "$drop_queue" || { rm -f -- "$drop_matched"; exit 1; }
		exec 8>&-

		# Account for every removed commit. Dropping is irreversible — the
		# receiver's accepted ledger is append-only — so a commit deleted here
		# would otherwise carry no CI verdict for the rest of time. The badge is
		# commit-addressable only: a commit that never ran cannot speak for the
		# repository's current status.
		drop_empty_targets="$(mktemp "${TMPDIR:-/tmp}/mechatron-drop-targets.XXXXXX.ndjson")" || exit 1
		: > "$drop_empty_targets"
		drop_line=0
		while IFS= read -r drop_record; do
			[ -n "$drop_record" ] || continue
			drop_line=$((drop_line + 1))
			drop_repo="$(jq -r '.repo // ""' <<< "$drop_record")"
			drop_ref="$(jq -r '.ref // ""' <<< "$drop_record")"
			drop_sha="$(jq -r '.sha // ""' <<< "$drop_record")"
			drop_delivery="$(jq -r '.delivery // ""' <<< "$drop_record")"
			if ! valid_repo_full_name "$drop_repo" || ! valid_commit_sha "$drop_sha"; then continue; fi
			record_ci_result "$state_dir/results.sqlite3" \
				"drop-$now-$drop_line-${drop_sha:0:12}" "$drop_delivery" "$drop_repo" "$drop_ref" "$drop_sha" '' \
				"$now" "$now" stopped cancelled "cancelled from the queue by an operator" \
				'' "$drop_empty_targets" >/dev/null 2>&1 || true
			exec 7> "$state_dir/.results.lock" || exit 1
			flock 7 || exit 1
			printf '%s\n' "$(jq -cn \
				--arg started_at "$now" --arg finished_at "$now" --arg delivery "$drop_delivery" \
				--arg repo "$drop_repo" --arg ref "$drop_ref" --arg sha "$drop_sha" \
				'{started_at:$started_at,finished_at:$finished_at,delivery:$delivery,repo:$repo,ref:$ref,sha:$sha,status:"stopped",failure_stage:"cancelled",failure_detail:"cancelled from the queue by an operator",targets:[],paths:[],log:""}')" \
				>> "$state_dir/results.ndjson"
			exec 7>&-
			write_commit_badge_status "$badge_dir" "$drop_repo" CANCELLED "$drop_sha" || true
		done < "$drop_matched"
		rm -f -- "$drop_matched" "$drop_empty_targets"

		jq -cn --arg action drop --argjson dropped "$drop_count" '{status:"ok",action:$action,dropped:$dropped}'
		exit 0
		;;
	retry)
		# Requeue one exact commit whose last run was stopped by infrastructure
		# (the source fetch never observed the project's code). The receiver's
		# accepted ledger deduplicates by delivery and by repository+commit for
		# good, so a GitHub redelivery can never do this; the retry record gets
		# a fresh delivery id instead and the ledger stays untouched. Timeouts,
		# policy refusals and real failures are not retryable here.
		shift
		retry_project=""
		retry_commit=""
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--project) [ "$#" -ge 2 ] || { printf 'retry: --project requires a value\n' >&2; exit 2; }; shift; retry_project="$1" ;;
				--commit) [ "$#" -ge 2 ] || { printf 'retry: --commit requires a value\n' >&2; exit 2; }; shift; retry_commit="$1" ;;
				*) printf 'retry: unknown option: %s\n' "$1" >&2; exit 2 ;;
			esac
			shift
		done
		[ -n "$retry_project" ] || { printf 'retry: --project is required\n' >&2; exit 2; }
		[[ "$retry_commit" =~ ^[0-9a-f]{7,40}$ ]] || { printf 'retry: --commit needs 7 to 40 lowercase hex digits\n' >&2; exit 2; }
		retry_project="${retry_project##*/}"
		retry_database="$state_dir/results.sqlite3"
		retry_queue="$state_dir/queue/builds.ndjson"
		retry_lock="$state_dir/queue/.builds.lock"
		retry_limit=2
		retry_refuse() {
			jq -cn --arg commit "$retry_commit" --arg reason "$1" '{status:"refused",action:"retry",commit:$commit,reason:$reason}'
			exit 1
		}
		retry_sql() { sqlite3 -bail -json -cmd '.timeout 5000' "$retry_database" "$1"; }
		[ -f "$retry_database" ] || retry_refuse "no CI ledger"
		retry_scope="substr(repository, instr(repository, '/') + 1) = $(sql_quote "$retry_project")"

		# The prefix must name exactly one commit of this project in the ledger.
		retry_matches="$(retry_sql "SELECT DISTINCT commit_sha FROM ci_runs WHERE $retry_scope AND commit_sha LIKE $(sql_quote "$retry_commit") || '%';")" || exit 1
		case "$(jq -r 'length' <<< "${retry_matches:-[]}")" in
			0) retry_refuse "no CI result for that commit" ;;
			1) retry_sha="$(jq -r '.[0].commit_sha' <<< "$retry_matches")" ;;
			*) retry_refuse "commit prefix is ambiguous" ;;
		esac

		retry_runs="$(retry_sql "SELECT delivery_id, repository, ref, default_branch, status, failure_stage FROM ci_runs WHERE $retry_scope AND commit_sha = $(sql_quote "$retry_sha") ORDER BY finished_at DESC, rowid DESC;")" || exit 1
		retry_status="$(jq -r '.[0].status' <<< "$retry_runs")"
		retry_stage="$(jq -r '.[0].failure_stage' <<< "$retry_runs")"
		case "$retry_status/$retry_stage" in
			stopped/source-fetch|stopped/github-timeout) ;;
			*) retry_refuse "latest result is $retry_status ($retry_stage), not an infrastructure stop" ;;
		esac
		retry_used="$(jq -r '[.[] | select(.delivery_id | startswith("retry-"))] | length' <<< "$retry_runs")"
		[ "$retry_used" -lt "$retry_limit" ] || retry_refuse "retry limit of $retry_limit reached"
		retry_origin="$(jq -r '[.[] | select(.delivery_id | startswith("retry-") | not)] | last // .[-1] | .delivery_id' <<< "$retry_runs")"
		retry_record="$(jq -cn --arg ts "$now" --arg delivery "retry-$((retry_used + 1))-$retry_origin" \
			--argjson row "$(jq -c '.[0]' <<< "$retry_runs")" --arg sha "$retry_sha" --arg retry_of "$retry_origin" \
			'{ts:$ts,delivery:$delivery,repo:$row.repository,ref:$row.ref,sha:$sha,default_branch:$row.default_branch,status:"queued",retry_of:$retry_of}')" || exit 1

		# Append under the receiver's own lock. A record for this commit that is
		# still waiting makes the retry an idempotent no-op.
		exec 8> "$retry_lock" || exit 1
		flock 8 || exit 1
		if [ -s "$retry_queue" ] && [ "$(select_queue_records match "$retry_project" '' "$retry_sha" < "$retry_queue" | wc -l | tr -d ' ')" -gt 0 ]; then
			exec 8>&-
			jq -cn --arg repo "$(jq -r .repo <<< "$retry_record")" --arg sha "$retry_sha" \
				'{status:"ok",action:"retry",queued:false,reason:"already queued",repo:$repo,sha:$sha}'
			exit 0
		fi
		if [ ! -e "$retry_queue" ]; then
			: > "$retry_queue" || exit 1
			chown --reference="$state_dir/queue" "$retry_queue" 2>/dev/null || true
		fi
		printf '%s\n' "$retry_record" >> "$retry_queue" || exit 1
		chmod 0640 "$retry_queue" || exit 1
		exec 8>&-
		jq -c '{status:"ok",action:"retry",queued:true,delivery:.delivery,repo:.repo,sha:.sha}' <<< "$retry_record"
		exit 0
		;;
	--help|-h)
		printf 'Usage: mechatron-prime-control {halt|resume|cancel|drop --project P [--branch B] [--commit SHA]|retry --project P --commit SHA}\n'
		exit 0
		;;
	*)
		printf 'Usage: mechatron-prime-control {halt|resume|cancel|drop --project P [--branch B] [--commit SHA]|retry --project P --commit SHA}\n' >&2
		exit 2
		;;
esac

jq -cn --arg action "$action" --arg state "$(ci_admission_state "$state_dir")" \
	'{status:"ok",action:$action,admission:$state}'
