#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "$0")" && pwd)"
vendored="$root/mechatron-prime"
failures=0

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

check_sha256() {
	local relative="$1"
	local expected="$2"
	local path="$vendored/$relative"
	local actual

	if [ ! -f "$path" ]; then
		fail "missing vendored file: $relative"
		return
	fi

	actual="$(sha256sum "$path" | cut -d' ' -f1)"
	if [ "$actual" != "$expected" ]; then
		fail "$relative differs from Mechatron Prime b83a195"
	fi
}

check_wrapper() {
	local path="$1"
	local expected="$2"
	local actual

	actual="$(tr -d '\n' < "$path")"
	if [ "$actual" != "$expected" ]; then
		fail "$(basename "$path") does not import the vendored module"
	fi
}

check_sha256 nixos/receiver.nix 4d0ca79459a39e7c4ca4eb0adce7b1c3ca036a7da2f6cf93e45a44c290ee80f1
check_sha256 nixos/repos.nix 46fdce97d7f117b2e54f367d74b9e1942ba451750866c07de21ccbaf79c53490
check_sha256 nixos/worker.nix cb499ca98981112b7dd9e00de36d6802d03becd1d9efc2fb1f4fbc1fc1b354b0
check_sha256 scripts/policy.bash a78b6a7767a4cbf16e2ccc09fdc1e74853f475be042782ad6854808b4e67c479
check_sha256 scripts/receiver.bash a8dac3229c61686607206c8e4c7320ebc6ecddfb1d4dbde2daefc765c08ed45b
check_sha256 scripts/worker.bash e70159743178246599185c839e9d331e8acca3fce92b7bd450af95ada5e11873

check_wrapper "$root/mechatron-prime-receiver.nix" 'import ./mechatron-prime/nixos/receiver.nix'
check_wrapper "$root/mechatron-prime-worker.nix" 'import ./mechatron-prime/nixos/worker.nix'

if [ "$failures" -ne 0 ]; then
	printf '%d Mechatron Prime integration check(s) failed\n' "$failures" >&2
	exit 1
fi

printf 'Mechatron Prime integration matches source commit b83a195\n'
