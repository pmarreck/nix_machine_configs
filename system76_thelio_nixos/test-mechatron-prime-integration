#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "$0")" && pwd)"
vendored="$root/mechatron-prime"
failures=0
source_commit=76235ec

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

check_sha256() {
	local relative="$1"
	local expected="$2"
	local path="$vendored/$relative"
	local actual

	if [ ! -f "$path" ]; then
		fail "missing vendored file: $relative"
		return
	fi

	actual="$(sha256sum "$path" | cut -d' ' -f1)"
	if [ "$actual" != "$expected" ]; then
		fail "$relative differs from Mechatron Prime $source_commit"
	fi
}

check_wrapper() {
	local path="$1"
	local expected="$2"
	local actual

	actual="$(tr -d '\n' < "$path")"
	if [ "$actual" != "$expected" ]; then
		fail "$(basename "$path") does not import the vendored module"
	fi
}

